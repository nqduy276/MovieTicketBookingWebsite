# ==========================================
# Database Connection — MySQL (CineBook)
# ==========================================
# Before running the API, load the schema:
#   mysql -u root -p < sql/01_schema.sql
#   mysql -u root -p CineBook < sql/02_procedures.sql
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/CineBook

# ==========================================
# Security / JWT
# ==========================================
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS - frontend origins (comma separated)
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Loyalty rules
# ==========================================
LOYALTY_POINTS_PER_VND=0.0001   # 1 point per 10,000 VND
