# ==========================================
# Database Connection — MySQL (CineBook)
# ==========================================
# Default: MySQL root with NO password (the project assumes a passwordless
# root@localhost for ease of setup). If your MySQL root has a password,
# put it between `root:` and `@localhost`, URL-encoding any special chars
# (@ → %40, : → %3A, / → %2F, # → %23, etc).
#
# Before running the API, load the schema with reset_db.sh (or manually):
#   mysql -u root < backend/sql/create_tables.sql
#   mysql -u root CineBook < backend/sql/database_logic.sql
#   mysql -u root CineBook < backend/sql/database_logic_P2.sql
#   mysql -u root CineBook < backend/sql/database_logic_P4.sql
DATABASE_URL=mysql+pymysql://root:@localhost:3306/CineBook?charset=utf8mb4

# ==========================================
# Security / JWT
# ==========================================
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CORS - frontend origins (comma separated)
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Loyalty rules
# ==========================================
LOYALTY_POINTS_PER_VND=0.0001   # 1 point per 10,000 VND
